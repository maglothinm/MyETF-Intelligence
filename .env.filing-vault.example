# Server-only runtime. Do not copy secrets into GitHub Pages or a browser bundle.
VAULT_ENV=production
# For embedding in the existing Flask API only; standalone factory is explicit.
VAULT_ENABLED=false
VAULT_DATABASE_URL=
VAULT_STORAGE_BACKEND=supabase
VAULT_SUPABASE_URL=
VAULT_SUPABASE_KEY=
VAULT_SUPABASE_BUCKET=filing-vault
VAULT_SECRET_KEY=
# Exact dashboard origin, not a path. Multiple origins are comma-separated.
VAULT_ALLOWED_ORIGINS=https://maglothinm.github.io
# Set only after separately reviewing/affirming each government's source notice.
VAULT_ACKNOWLEDGED_SOURCES=
# Exact configured government agency hosts, no wildcards.
VAULT_AGENCY_HOSTS=
VAULT_MAX_DOCUMENT_BYTES=26214400
# Verified canonical publisher catalog supplied to the runtime by the operator.
VAULT_CATALOG_PATH=/srv/polititrack/catalog/filing-resources.json
# Development only: use a folder OUTSIDE all Git checkouts.
VAULT_FILE_ROOT=
# Public static build configuration: HTTPS origin only; no API path or secrets.
FILING_VAULT_API_ORIGIN=
