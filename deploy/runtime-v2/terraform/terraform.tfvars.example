project_id = "your-billing-enabled-project-id"
region     = "us-central1"
image      = "us-central1-docker.pkg.dev/your-billing-enabled-project-id/polititrack/runtime-v2@sha256:replace-me"

# Values are existing Secret Manager secret IDs, never secret values. Terraform
# creates a separate high-entropy database password in Secret Manager and grants
# only database-using Runtime v2 identities access to that generated secret.
# Phase 3 should supply only read-only analysis credentials that are required for
# shadow execution; notification and callback secrets remain omitted.
runtime_secrets = {
  OPENAI_API_KEY = "polititrack-openai-api-key"
}

# Phase 3 remains in shadow mode. A later release must change this to production
# explicitly before schedules can be enabled.
runtime_environment = {
  POLITITRACK_MODE = "shadow"
}

vault_enabled             = false
schedules_enabled         = false
public_dashboard_enabled  = false
vault_bucket_name         = null
dashboard_allowed_origins = ""
