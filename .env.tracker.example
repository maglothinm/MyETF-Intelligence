# Local shell example only. GitHub Actions values belong in repository variables/secrets.
DISCLOSURE_TERMS_ACKNOWLEDGED=false
REQUIRE_PUSHOVER=false
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
NOTIFY_EQUITY_ONLY=true
NOTIFY_PENDING_REVIEWS=true
NOTIFY_ALL_FILINGS=true
WATCHLIST=
SENATE_LOOKBACK_DAYS=180
ALLOW_EMPTY_SOURCES=false
ALLOW_STATE_INITIALIZATION=false
BOOTSTRAP_ALERTS=false
DISCLOSURE_USER_AGENT="Mozilla/5.0 (compatible; PolitiTrackGovernmentTradeTracker/1.0; +https://github.com/maglothinm/PolitiTrack)"

# AI filing analyst and paper-research portfolio
AI_ANALYSIS_ENABLED=false
AI_PAPER_TRADING_ONLY=true
AI_WEB_SEARCH_ENABLED=true
AI_FETCH_DOCUMENT_TEXT=true
AI_MAX_ANALYSES_PER_RUN=20
AI_REQUIRE_PUSHOVER=false
INVESTOR_EDGE_ENABLED=true
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_ENTITLEMENT=
# Optional Gmail candidate-alert channel. Configure both values or leave both blank.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SEC_USER_AGENT="PolitiTrack research contact your-email@example.com"
AI_HEALTHCHECKS_PING_URL=
# Optional override. GitHub Actions calculates the current repository Pages URL when blank.
DASHBOARD_URL=

# Filing Vault is a separate optional runtime. Only the public API origin belongs
# in the dashboard build; server credentials are documented in .env.filing-vault.example.
FILING_VAULT_API_ORIGIN=
