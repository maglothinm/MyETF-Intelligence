# Local shell example only. GitHub Actions values belong in repository variables/secrets.
DISCLOSURE_TERMS_ACKNOWLEDGED=false
REQUIRE_PUSHOVER=false
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
NOTIFY_EQUITY_ONLY=true
NOTIFY_PENDING_REVIEWS=true
NOTIFY_ALL_FILINGS=true
WATCHLIST=
SENATE_LOOKBACK_DAYS=180
ALLOW_EMPTY_SOURCES=false
ALLOW_STATE_INITIALIZATION=true
