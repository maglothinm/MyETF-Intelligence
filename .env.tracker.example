# Local shell example only. GitHub Actions values belong in repository variables/secrets.
DISCLOSURE_TERMS_ACKNOWLEDGED=false
REQUIRE_PUSHOVER=false
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
NOTIFY_EQUITY_ONLY=true
NOTIFY_PENDING_REVIEWS=true
NOTIFY_ALL_FILINGS=true
WATCHLIST=
SENATE_LOOKBACK_DAYS=180
ALLOW_EMPTY_SOURCES=false
ALLOW_STATE_INITIALIZATION=true

# AI filing analyst and paper-research portfolio
AI_ANALYSIS_ENABLED=false
AI_PAPER_TRADING_ONLY=true
AI_WEB_SEARCH_ENABLED=true
AI_FETCH_DOCUMENT_TEXT=true
AI_MAX_ANALYSES_PER_RUN=20
AI_REQUIRE_PUSHOVER=true
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_ENTITLEMENT=
SEC_USER_AGENT=PolitiTrack research contact your-email@example.com
AI_HEALTHCHECKS_PING_URL=
# Optional override. GitHub Actions calculates the current repository Pages URL when blank.
DASHBOARD_URL=
